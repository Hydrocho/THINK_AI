olor":"#132746","bold":false},{"kind":"image","name":"H-detail.png","x":635,"y":423.8805104408353,"w":880.0000000000001,"h":207.23897911832947},{"kind":"text","t":"학생 활동 화면 · 수업용 예시","x":635,"y":803,"w":880,"h":34,"size":20,"color":"#52627A","bold":false},{"kind":"text","t":"THINK  ·  AI 활용 생각 교실","x":80,"y":852,"w":1000,"h":28,"size":18,"color":"#52627A","bold":false},{"kind":"text","t":"04 / 9","x":1380,"y":852,"w":140,"h":28,"size":18,"color":"#52627A","bold":false}],"dark":false},{"title":"AI와 대화하기","notes":"학생 활동 · AI와 대화하며 궁금증 해결하기","items":[{"kind":"text","t":"I · 인공지능과 생각 넓히기","x":80,"y":55,"w":1450,"h":48,"size":24,"color":"#0D887E","bold":true},{"kind":"text","t":"AI와 대화하기","x":80,"y":126,"w":1460,"h":105,"size":57,"color":"#132746","bold":true},{"kind":"text","t":"학생 활동","x":80,"y":295,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"AI와 대화하며 궁금증 해결하기","x":80,"y":357,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"image","name":"I-chat-detail.png","x":635,"y":361.07888631090486,"w":880.0000000000001,"h":187.84222737819027},{"kind":"image","name":"I-chat-controls.png","x":635,"y":654.4559164733179,"w":880.0000000000001,"h":102.08816705336427},{"kind":"text","t":"학생 활동 화면 · 수업용 예시","x":635,"y":803,"w":880,"h":34,"size":20,"color":"#52627A","bold":false},{"kind":"text","t":"THINK  ·  AI 활용 생각 교실","x":80,"y":852,"w":1000,"h":28,"size":18,"color":"#52627A","bold":false},{"kind":"text","t":"05 / 9","x":1380,"y":852,"w":140,"h":28,"size":18,"color":"#52627A","bold":false}],"dark":false},{"title":"대화 후 내 생각 정리하기","notes":"① 내가 알아보려던 점 · 대화에서 가장 알고 싶었던 점 쓰기\n② 새로 알게 된 점 · 새로 알게 된 내용을 내 말로 쓰기\n③ 내 생각에 연결하기 · 대화하며 달라졌거나 더 분명해진 내 생각 쓰기","items":[{"kind":"text","t":"I · 인공지능과 생각 넓히기","x":80,"y":55,"w":1450,"h":48,"size":24,"color":"#0D887E","bold":true},{"kind":"text","t":"대화 후 내 생각 정리하기","x":80,"y":126,"w":1460,"h":105,"size":57,"color":"#132746","bold":true},{"kind":"text","t":"① 내가 알아보려던 점","x":80,"y":295,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"대화에서 가장 알고 싶었던 점 쓰기","x":80,"y":357,"w":505,"h":105,"size":29,"color":"#132746","bold":false},{"kind":"text","t":"② 새로 알게 된 점","x":80,"y":465,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"새로 알게 된 내용을 내 말로 쓰기","x":80,"y":527,"w":505,"h":105,"size":29,"color":"#132746","bold":false},{"kind":"text","t":"③ 내 생각에 연결하기","x":80,"y":635,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"대화하며 달라졌거나 더 분명해진 내 생각 쓰기","x":80,"y":697,"w":505,"h":105,"size":29,"color":"#132746","bold":false},{"kind":"image","name":"I-reflect-screen.png","x":686.2,"y":248,"w":777.6,"h":540},{"kind":"text","t":"학생 활동 화면 · 수업용 예시","x":635,"y":803,"w":880,"h":34,"size":20,"color":"#52627A","bold":false},{"kind":"text","t":"THINK  ·  AI 활용 생각 교실","x":80,"y":852,"w":1000,"h":28,"size":18,"color":"#52627A","bold":false},{"kind":"text","t":"06 / 9","x":1380,"y":852,"w":140,"h":28,"size":18,"color":"#52627A","bold":false}],"dark":false},{"title":"AI와 나눈 이야기를 자료로 확인하기","notes":"① AI와 대화 후 내 생각 다시 보기 · AI와 대화 내용을 비판적으로 다시 생각해보기\n② 다른 자료와 비교해 보니 어땠나요? · 다른 자료에서 확인한 내용과 출처 남기기\n예시 자료 · WHO (2021) https://www.who.int/news/item/12-07-2021-who-issues-new-recommendations-on-human-genome-editing-for-the-advancement-of-public-health","items":[{"kind":"text","t":"N · 비판적으로 따져보기","x":80,"y":55,"w":1450,"h":48,"size":24,"color":"#0D887E","bold":true},{"kind":"text","t":"AI와 나눈 이야기를 자료로 확인하기","x":80,"y":126,"w":1460,"h":105,"size":57,"color":"#132746","bold":true},{"kind":"text","t":"① AI와 대화 후 내 생각 다시 보기","x":80,"y":295,"w":505,"h":62,"size":25,"color":"#0D887E","bold":true},{"kind":"text","t":"AI와 대화 내용을 비판적으로 다시 생각해보기","x":80,"y":357,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"text","t":"② 다른 자료와 비교해 보니 어땠나요?","x":80,"y":530,"w":505,"h":62,"size":25,"color":"#0D887E","bold":true},{"kind":"text","t":"다른 자료에서 확인한 내용과 출처 남기기","x":80,"y":592,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"image","name":"N-detail.png","x":635,"y":327.0951276102088,"w":880.0000000000001,"h":381.8097447795824},{"kind":"text","t":"학생 활동 화면 · 수업용 예시","x":635,"y":803,"w":880,"h":34,"size":20,"color":"#52627A","bold":false},{"kind":"text","t":"THINK  ·  AI 활용 생각 교실","x":80,"y":852,"w":1000,"h":28,"size":18,"color":"#52627A","bold":false},{"kind":"text","t":"07 / 9","x":1380,"y":852,"w":140,"h":28,"size":18,"color":"#52627A","bold":false}],"dark":false},{"title":"내 판단을 쓰고 친구의 검토 읽기","notes":"③ 확인한 뒤에도 내 생각은 같은가요? · 자료를 읽은 뒤 내 생각과 이유 쓰기\n친구의 검토 읽기 · 친구들이 무엇을 찾아보고 어떤 생각을 했는지 읽기","items":[{"kind":"text","t":"N · 비판적으로 따져보기","x":80,"y":55,"w":1450,"h":48,"size":24,"color":"#0D887E","bold":true},{"kind":"text","t":"내 판단을 쓰고 친구의 검토 읽기","x":80,"y":126,"w":1460,"h":105,"size":57,"color":"#132746","bold":true},{"kind":"text","t":"③ 확인한 뒤에도 내 생각은 같은가요?","x":80,"y":295,"w":505,"h":62,"size":25,"color":"#0D887E","bold":true},{"kind":"text","t":"자료를 읽은 뒤 내 생각과 이유 쓰기","x":80,"y":357,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"text","t":"친구의 검토 읽기","x":80,"y":530,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"친구들이 무엇을 찾아보고 어떤 생각을 했는지 읽기","x":80,"y":592,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"image","name":"N-peer-detail.png","x":635,"y":348.4396751740139,"w":880.0000000000001,"h":348.1206496519722},{"kind":"text","t":"학생 활동 화면 · 수업용 예시","x":635,"y":803,"w":880,"h":34,"size":20,"color":"#52627A","bold":false},{"kind":"text","t":"THINK  ·  AI 활용 생각 교실","x":80,"y":852,"w":1000,"h":28,"size":18,"color":"#52627A","bold":false},{"kind":"text","t":"08 / 9","x":1380,"y":852,"w":140,"h":28,"size":18,"color":"#52627A","bold":false}],"dark":false},{"title":"이전 활동을 돌아보고 최종 글 쓰기","notes":"이전 활동 돌아보기 · 처음 쓴 글과 친구의 의견, AI 대화 후 쓴 글, 자료에서 확인한 내용 돌아보기\n나의 최종 글 · 수업 질문에 대한 최종 입장과 이유를 한 편의 글로 쓰기","items":[{"kind":"text","t":"K · 나의 최종 생각","x":80,"y":55,"w":1450,"h":48,"size":24,"color":"#0D887E","bold":true},{"kind":"text","t":"이전 활동을 돌아보고 최종 글 쓰기","x":80,"y":126,"w":1460,"h":105,"size":57,"color":"#132746","bold":true},{"kind":"text","t":"이전 활동 돌아보기","x":80,"y":295,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"처음 쓴 글과 친구의 의견, AI 대화 후 쓴 글, 자료에서 확인한 내용 돌아보기","x":80,"y":357,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"text","t":"나의 최종 글","x":80,"y":530,"w":505,"h":62,"size":32,"color":"#0D887E","bold":true},{"kind":"text","t":"수업 질문에 대한 최종 입장과 이유를 한 편의 글로 쓰기","x":80,"y":592,"w":505,"h":170,"size":29,"color":"#132746","bold":false},{"kind":"image","name":"K-tabs.png","x":635,"y":305.6175059952038,"w":880.0000000000001,"h":33.76498800959233},{"kind":"image","name":"K-detail.png","x":635,"y":437.1256038647343,"w":880,"h":215.74879227053142},{"kind":"image","name":"K-save.png","x":1015.7608695652174,"y":710,"w":118.4782608695652,"h":50},{"kind":"text","t":"학생 활동 화면 · 수업용 예시","x":635,"y":803,"w":880,"h":34,"size":20,"color":"#52627A","bold":false},{"kind":"text","t":"THINK  ·  AI 활용 생각 교실","x":80,"y":852,"w":1000,"h":28,"size":18,"color":"#52627A","bold":false},{"kind":"text","t":"09 / 9","x":1380,"y":852,"w":140,"h":28,"size":18,"color":"#52627A","bold":false}],"dark":false}],"assets":{"H-detail.png":{"w":862,"h":203,"url":"data:image/png;base64,"},"H-full.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"H-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"I-chat-controls.png":{"w":862,"h":100,"url":"data:image/png;base64,"},"I-chat-detail.png":{"w":862,"h":184,"url":"data:image/png;base64,"},"I-chat-full.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"I-chat-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"I-reflect-detail.png":{"w":862,"h":239,"url":"data:image/png;base64,"},"I-reflect-full.png":{"w":1440,"h":1238,"url":"data:image/png;base64,"},"I-reflect-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"K-detail.png":{"w":828,"h":203,"url":"data:image/png;base64,"},"K-full.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"K-save.png":{"w":109,"h":46,"url":"data:image/png;base64,"},"K-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"K-tabs.png":{"w":834,"h":32,"url":"data:image/png;base64,"},"N-detail.png":{"w":862,"h":374,"url":"data:image/png;base64,"},"N-full.png":{"w":1440,"h":1257,"url":"data:image/png;base64,"},"N-peer-detail.png":{"w":862,"h":341,"url":"data:image/png;base64,"},"N-peer-full.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"N-peer-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"N-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"T-detail.png":{"w":862,"h":259,"url":"data:image/png;base64,"},"T-full.png":{"w":1440,"h":1577,"url":"data:image/png;base64,"},"T-screen.png":{"w":1440,"h":1000,"url":"data:image/png;base64,"},"T-field0.png":{"w":862,"h":259,"url":"data:image/png;base64,"},"T-field1.png":{"w":862,"h":259,"url":"data:image/png;base64,"},"T-field3.png":{"w":862,"h":259,"url":"data:image/png;base64,"},"T-field4.png":{"w":862,"h":259,"url":"data:image/png;base64,"}}}</script><script>
const {slides,assets}=JSON.parse(document.getElementById('presentation-data').textContent);let current=0;const canvas=document.getElementById('canvas'),viewport=document.getElementById('viewport'),jump=document.getElementById('jump'),zoom=document.getElementById('zoom');let fullUrl;
slides.forEach((s,i)=>jump.add(new Option((i+1)+' / '+slides.length+'  '+s.title,i)));
function resize(){if(document.fullscreenElement){const w=Math.min(innerWidth,(innerHeight-62)*16/9);viewport.style.width=w+"px";viewport.style.height=w*9/16+"px";canvas.style.transform="scale("+w/1600+")";return;}const width=Math.min(innerWidth- (innerWidth<=650?16:48),Math.max(600,(innerHeight-255)*16/9),1600);viewport.style.width=Math.max(280,width)+'px';viewport.style.height=Math.max(280,width)*9/16+'px';canvas.style.transform='scale('+Math.max(280,width)/1600+')'}
function show(n){current=Math.max(0,Math.min(slides.length-1,n));const s=slides[current];canvas.replaceChildren();canvas.style.background=s.dark?'#132746':'#ffffff';canvas.setAttribute('aria-label',(current+1)+' / '+slides.length+' '+s.title);for(const a of s.items){const e=document.createElement(a.kind==='text'?'div':'button');e.className='item'+(a.kind==='image'?' photo':'');Object.assign(e.style,{left:a.x+'px',top:a.y+'px',width:a.w+'px',height:a.h+'px'});if(a.kind==='text'){if(a.size>100)e.style.height=(a.h+10)+'px';e.textContent=a.t;Object.assign(e.style,{fontSize:a.size+'px',fontWeight:a.bold?'700':'400',color:a.color});}else{e.setAttribute('aria-label','화면 확대: '+a.name);const img=new Image();img.src=assets[a.name].url;img.alt='THINK 학생 활동 화면 · 발표용 예시';e.append(img);e.onclick=()=>openImage(a.name);}canvas.append(e)}jump.value=current;document.getElementById('prev').disabled=current===0;document.getElementById('next').disabled=current===slides.length-1;document.getElementById('notes').textContent=s.notes;history.replaceState(null,'','#slide-'+(current+1));}
function dataBlob(url){const raw=atob(url.split(',')[1]),bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);return new Blob([bytes],{type:'image/png'})}
function openImage(name){document.getElementById('zoomImage').src=assets[name].url;const full=name.startsWith("T-field")?"T-full.png":name.replace(/-(screen|detail|tabs|save|controls)\.png$/,'-full.png');if(fullUrl)URL.revokeObjectURL(fullUrl);fullUrl=URL.createObjectURL(dataBlob(assets[full]?.url||assets[name].url));document.getElementById('fullCapture').href=fullUrl;zoom.showModal();}
document.getElementById('closeZoom').onclick=()=>zoom.close();zoom.addEventListener('click',e=>{if(e.target===zoom)zoom.close()});document.getElementById('prev').onclick=()=>show(current-1);document.getElementById('next').onclick=()=>show(current+1);jump.onchange=()=>show(Number(jump.value));window.addEventListener('keydown',e=>{if(zoom.open||['SELECT','INPUT','TEXTAREA'].includes(document.activeElement.tagName)||e.altKey||e.ctrlKey||e.metaKey)return;if(['ArrowRight','PageDown','ArrowLeft','PageUp','Home','End'].includes(e.key)){e.preventDefault();show(e.key==='Home'?0:e.key==='End'?slides.length-1:current+(['ArrowRight','PageDown'].includes(e.key)?1:-1))}});window.addEventListener('resize',resize);
async function download(kind){const status=document.getElementById('downloadStatus');status.textContent='PPT 파일을 준비하고 있습니다…';try{const node=document.getElementById('ppt-'+kind);if(!node)throw Error('PPT 파일이 포함되지 않았습니다.');const raw=atob(node.textContent.trim()),bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);const url=URL.createObjectURL(new Blob([bytes],{type:'application/vnd.openxmlformats-officedocument.presentationml.presentation'}));const a=document.createElement('a');a.href=url;a.download='THINK-guide-'+kind+'.pptx';a.click();setTimeout(()=>URL.revokeObjectURL(url),30000);status.textContent=(kind==='editable'?'편집형':'화면형')+' PPT 다운로드를 시작했습니다.';}catch(e){status.textContent='저장하지 못했습니다: '+e.message;}}
document.getElementById('editable').onclick=()=>download('editable');document.getElementById('visual').onclick=()=>download('visual');show((Number(location.hash.match(/slide-(\d+)/)?.[1])||1)-1);resize();window.deckApi={show,slides};document.getElementById("enterFull").onclick=async()=>{try{await document.documentElement.requestFullscreen()}catch{document.getElementById("downloadStatus").textContent="이 브라우저에서 전체 화면을 열 수 없습니다."}};document.getElementById("leaveFull").onclick=()=>document.exitFullscreen();document.addEventListener("fullscreenchange",resize);
</script><script type="application/octet-stream" id="ppt-editable"></script><script type="application/octet-stream" id="ppt-visual"></script></body></html>